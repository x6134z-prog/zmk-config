#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        td_center_fullscreen: tap_dance_center_fullscreen {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LC(K_APP(C))>, <&kp LC(K_APP(F))>;
        };

        td_close_clear: tap_dance_close_clear {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LG(W)>, <&kp LG(K)>;
        };

        td_screenshot: tap_dance_screenshot {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp LG(LS(N4))>, <&kp LG(LS(N3))>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            bindings = <
                &kp LC(UP)         &td_center_fullscreen  &td_close_clear     &td_screenshot
                &kp LG(Z)          &kp LG(A)              &kp LG(C)           &kp LG(V)          &kp RET
                &kp C_PLAY_PAUSE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
